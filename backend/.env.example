# Sao chép các tên biến này vào Environment variables của IntelliJ
# hoặc thiết lập trong terminal trước khi chạy backend. Không commit file .env thật.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=QuanLyGaraOTo;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=your_sql_server_password

JWT_SECRET=replace_with_a_secret_of_at_least_32_characters
JWT_EXPIRATION=86400000

SERVER_PORT=8080
