# Sao chép file này thành .env, điền cấu hình local rồi chạy .\run-dev.ps1.
# Không commit file .env thật.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=QuanLyGaraOTo;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=your_sql_server_password

JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=86400000

SERVER_PORT=8080
